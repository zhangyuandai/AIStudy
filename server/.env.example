# ============================================================
#  滑板公社服务端环境变量模板
#  复制为 .env 并填入实际值
# ============================================================

# ---- 服务端口 ----
PORT=3001
NODE_ENV=development

# ---- 数据库 MySQL 8.0+ ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_password_here
DB_NAME=skate_club
DB_CHARSET=utf8mb4
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=30000
DB_TIMEOUT=60000

# ---- JWT 认证 ----
JWT_SECRET=change-me-to-a-random-secret-string-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=24h

# ---- 微信小程序 ----
WX_APP_ID=wx_your_app_id
WX_APP_SECRET=your_app_secret

# ---- 文件上传（本地存储）----
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=5242880

# ---- 日志 ----
LOG_LEVEL=debug

# ---- 管理员默认账号（首次部署自动创建）----
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
