<!-- 积分商城页面 -->
<view class="page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-bar__input-wrap">
      <text class="search-bar__icon">🔍</text>
      <input
        class="search-bar__input"
        placeholder="搜索礼品"
        value="{{keyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="doSearch"
      />
      <view class="search-bar__clear" wx:if="{{keyword}}" bindtap="clearSearch">
        <text>✕</text>
      </view>
    </view>

    <!-- 购物车入口 -->
    <view class="search-bar__cart" bindtap="goMyOrders">
      <image src="/assets/icons/cart.png" mode="aspectFit" style="width:44rpx;height:44rpx;" />
      <view class="search-bar__cart-badge" wx:if="{{cartCount > 0}}">
        <text>{{cartCount}}</text>
      </view>
    </view>
  </view>

  <!-- 分类 Tab -->
  <scroll-view scroll-x class="category-tabs" enhanced show-scrollbar="{{false}}">
    <view
      class="category-tab {{currentCategory === item.code ? 'category-tab--active' : ''}}"
      wx:for="{{categories}}"
      wx:key="code"
      data-code="{{item.code}}"
      bindtap="onCategoryChange"
    >
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 礼品列表 -->
  <view class="gift-list" wx:if="{{giftList.length > 0}}">
    <gift-card
      wx:for="{{giftList}}"
      wx:key="gift_id"
      item="{{item}}"
      showCategory="{{currentCategory === ''}}"
      bind:gifttap="onGiftTap"
    />
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{!loading}}"
    text="{{keyword ? '没有找到相关礼品' : '暂无礼品'}}"
    actionText="{{keyword ? '清除搜索' : ''}}"
    bind:action="{{keyword ? 'clearSearch' : ''}}"
  />

  <!-- 加载状态 -->
  <view class="load-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{!loading && giftList.length > 0 && !hasMore}}">
    <text>— 已经到底了 —</text>
  </view>

  <view class="safe-bottom"></view>
</view>
