/* 兑换订单处理页面样式 */
.page { min-height: 100vh; background: var(--bg-color); padding-bottom: 60rpx; }

/* 状态筛选Tab */
.status-tabs {
  display: flex;
  background: var(--bg-white);
  padding: 0 8rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.status-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}

.status-tab--active {
  color: var(--primary-color);
  font-weight: bold;
}

.status-tab--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--primary-color);
}

.status-tab__count {
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #ff4444;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

/* 订单列表滚动区域 */
.order-scroll { height: calc(100vh - 88rpx); }

/* 订单卡片 */
.order-card {
  margin: 16rpx 24rpx;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.order-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.order-card__header-left { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; }

.order-card__gift-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: #f5f5f5;
}

.order-card__gift-info { flex: 1; min-width: 0; }
.order-card__gift-name { font-size: 28rpx; font-weight: bold; color: var(--text-primary); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.3; }
.order-card__user-name { font-size: 22rpx; color: var(--text-muted); margin-top: 4rpx; display: block; }

.order-card__points {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--primary-color);
  white-space: nowrap;
  flex-shrink: 0;
  padding-top: 4rpx;
}

/* 收货信息 */
.order-card__address {
  display: flex;
  gap: 10rpx;
  padding: 16rpx;
  background: var(--bg-color);
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
}
.order-card__addr-icon { font-size: 28rpx; flex-shrink: 0; }

.order-card__addr-detail { flex: 1; min-width: 0; }
.order-card__addr-name { font-size: 25rpx; color: var(--text-primary); display: block; }
.order-card__addr-text { font-size: 23rpx; color: var(--text-secondary); margin-top: 4rpx; display: block; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 虚拟商品标签 */
.order-card__virtual-tag {
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, #e8f4fd, #f0f7ff);
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #1677ff;
}

/* 卡片底部 */
.order-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.order-card__time { font-size: 22rpx; color: var(--text-muted); }

.order-actions { display: flex; gap: 12rpx; }

.btn-sm { height: 60rpx; line-height: 60rpx; font-size: 24rpx; padding: 0 24rpx; border-radius: 30rpx; }
.btn-success { background: var(--success-color) !important; color: #fff !important; }

.order-status-tag {
  font-size: 24rpx;
  color: var(--success-color);
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(107, 203, 119, 0.08);
}

/* 发货弹窗 */
.ship-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.ship-popup {
  width: 100%;
  max-height: 90vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.ship-popup__title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 28rpx;
  display: block;
}

.ship-popup__gift {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: var(--bg-color);
  border-radius: var(--radius-sm);
  margin-bottom: 20rpx;
}

.ship-popup__img { width: 72rpx; height: 72rpx; border-radius: var(--radius-sm); }
.ship-popup__name { font-size: 28rpx; font-weight: 500; color: var(--text-primary); }

.ship-popup__addr { padding: 20rpx; margin-bottom: 24rpx; }
.ship-popup__addr-label { font-size: 24rpx; font-weight: 500; color: var(--text-primary); display: block; margin-bottom: 8rpx; }
.ship-popup__addr-value { font-size: 27rpx; color: var(--text-secondary); display: block; }
.ship-popup__addr-detail { font-size: 24rpx; color: var(--text-muted); margin-top: 4rpx; display: block; line-height: 1.4; }

/* 发货表单 */
.ship-form { margin-bottom: 24rpx; }
.form-group { margin-bottom: 20rpx; }
.form-label { font-size: 26rpx; color: var(--text-primary); font-weight: 500; display: block; margin-bottom: 10rpx; }

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: var(--bg-color);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--text-secondary);
}
.form-picker text:last-child { font-size: 22rpx; }

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: var(--bg-color);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  box-sizing: border-box;
}

.ship-popup__actions { display: flex; gap: 16rpx; }

.safe-bottom { height: 60rpx; }
