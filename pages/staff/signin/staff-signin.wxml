<!-- 店员端学员签到页面 -->
<view class="page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-bar__input-wrap">
      <text class="search-bar__icon">🔍</text>
      <input
        class="search-bar__input"
        placeholder="搜索学员姓名/昵称"
        value="{{keyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="doSearch"
      />
    </view>
    <button
      class="search-bar__scan-btn btn btn-primary"
      size="mini"
      bindtap="scanCode"
    >扫码签到</button>
  </view>

  <!-- 签到统计 -->
  <view class="signin-stats card">
    <view class="signin-stat-item">
      <text class="signin-stat-value">{{studentList.length}}</text>
      <text class="signin-stat-label">总人数</text>
    </view>
    <view class="signin-stat-divider"></view>
    <view class="signin-stat-item">
      <text class="signin-stat-value signin-stat-value--done">{{checkedCount}}</text>
      <text class="signin-stat-label">已签到</text>
    </view>
    <view class="signin-stat-divider"></view>
    <view class="signin-stat-item">
      <text class="signin-stat-value">{{studentList.length - checkedCount}}</text>
      <text class="signin-stat-label">未签到</text>
    </view>
  </view>

  <!-- 学员列表 -->
  <view class="section-title" wx:if="{{studentList.length > 0}}">
    <text>学员列表（点击头像为学员签到）</text>
  </view>

  <!-- 已签到 -->
  <view class="student-list" wx:if="{{studentList.length > 0}}">
    <view
      class="student-card {{item.today_checked_in ? 'student-card--done' : ''}}"
      wx:for="{{studentList}}"
      wx:key="user_id"
      bindtap="onStudentTap"
      data-student="{{item}}"
    >
      <!-- 头像区域 -->
      <view class="student-card__avatar-wrap">
        <image
          class="student-card__avatar {{item.today_checked_in ? 'student-card__avatar--done' : ''}}"
          src="{{item.avatar || '/assets/icons/default-avatar.png'}}"
          mode="aspectFill"
        />
        <view class="student-card__check-badge" wx:if="{{item.today_checked_in}}">
          <text>✓</text>
        </view>
      </view>

      <!-- 学员信息 -->
      <view class="student-card__info">
        <text class="student-card__name">{{item.real_name || item.nickname}}</text>
        <text class="student-card__nickname" wx:if="{{item.real_name && item.nickname}}">@{{item.nickname}}</text>
        <text class="student-card__phone">{{item.phone || '-'}}</text>
      </view>

      <!-- 积分信息 -->
      <view class="student-card__points-info">
        <text class="student-card__points">{{item.total_points}}积分</text>
        <text
          class="student-card__status {{item.today_checked_in ? 'student-card__status--done' : ''}}"
        >
          {{item.today_checked_in ? '已签到' : '待签到'}}
        </text>
      </view>

      <!-- 操作按钮 -->
      <view class="student-card__action" wx:if="{{!item.today_checked_in}}">
        <text>签到</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{!loading}}"
    text="暂无学员数据"
    actionText="刷新"
    bind:action="loadStudents"
  />

  <!-- 加载状态 -->
  <view class="load-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- 确认签到弹窗 -->
<view class="confirm-mask" wx:if="{{showConfirm}}" catchtap="cancelCheckin">
  <view class="confirm-popup" catchtap="">
    <text class="confirm-popup__title">确认签到</text>
    <view class="confirm-popup__content">
      <image
        class="confirm-popup__avatar"
        src="{{selectedStudent.avatar || '/assets/icons/default-avatar.png'}}"
        mode="aspectFill"
      />
      <text class="confirm-popup__name">{{selectedStudent.real_name || selectedStudent.nickname}}</text>
      <text class="confirm-popup__desc">确认为此学员执行签到操作？</text>
      <view class="confirm-popup__points-hint">
        <text>本次将发放 +10 积分</text>
      </view>
    </view>
    <view class="confirm-popup__actions">
      <button class="btn btn-outline" style="flex:1;" bindtap="cancelCheckin">取消</button>
      <button
        class="btn btn-primary"
        style="flex:1;"
        loading="{{checkingIn}}"
        disabled="{{checkingIn}}"
        bindtap="confirmCheckin"
      >确认签到</button>
    </view>
  </view>
</view>
