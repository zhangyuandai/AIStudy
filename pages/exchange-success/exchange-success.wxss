/* 兑换成功页面样式 */
.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 60rpx;
}

/* 成功区域 */
.success-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 48rpx;
  background: linear-gradient(180deg, #1a1a2e 40%, var(--bg-color) 100%);
}

.success-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(107, 203, 119, 0.15), rgba(74, 222, 128, 0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  animation: popIn 0.5s ease-out;
}
@keyframes popIn {
  0% { transform: scale(0); opacity: 0; }
  70% { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}
.success-icon text { font-size: 80rpx; }

.success-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.success-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 订单卡片 */
.order-card { padding: 32rpx; }

.order-card__gift {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.order-card__gift-icon {
  font-size: 56rpx;
}

.order-card__gift-info { flex: 1; }

.order-card__gift-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.order-card__gift-points {
  font-size: 26rpx;
  color: var(--primary-color);
}

/* 订单详情行 */
.order-detail { padding-top: 4rpx; }

.order-detail__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.order-detail__label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.order-detail__value {
  font-size: 26rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
}

.order-detail__value--copy { color: #1677ff; }

.order-detail__status {
  color: var(--success-color) !important;
  font-weight: 500;
}

/* 提示卡片 */
.hint-card { padding: 28rpx 32rpx; }

.hint-card__title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: block;
}

.hint-item {
  padding: 10rpx 0;
}

.hint-item text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

/* 操作按钮组 */
.action-group {
  padding: 40rpx 48rpx 20rpx;
}

.action-group button {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.safe-bottom { height: 80rpx; }
