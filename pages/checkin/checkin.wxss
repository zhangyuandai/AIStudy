/* 签到页面样式 */
.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 60rpx;
}

/* 签到卡片 */
.checkin-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 48rpx;
  background: linear-gradient(180deg, #1a1a2e 0%, #2d2d5e 100%);
}

.checkin-card__circle {
  margin-bottom: 24rpx;
}

.checkin-card__ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 107, 53, 0.15), rgba(255, 217, 61, 0.08));
  border: 4rpx solid rgba(255, 107, 53, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-card--done .checkin-card__ring {
  border-color: #6bcb77;
  background: linear-gradient(135deg, rgba(107, 203, 119, 0.15), rgba(74, 222, 128, 0.08));
}

.checkin-card__icon {
  font-size: 72rpx;
}

.checkin-card__status {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.checkin-card__desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  margin-bottom: 20rpx;
}

.checkin-card__points {
  padding: 8rpx 32rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #ffd93d, #ff9f43);
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: bold;
  margin-top: 8rpx;
}

/* 二维码弹窗 */
.qrcode-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qrcode-popup {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-popup__title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 32rpx;
}

.qrcode-box {
  width: 400rpx;
  height: 400rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.qrcode-img { width: 100%; height: 100%; }

.qrcode-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.qrcode-placeholder text:first-child { font-size: 80rpx; }

.qrcode-placeholder__text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.qrcode-placeholder__code {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-color);
  letter-spacing: 4rpx;
}

.qrcode-popup__tip {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 本周签到日历 */
.week-calendar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.week-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.week-day__name {
  font-size: 24rpx;
  color: var(--text-muted);
}

.week-day__date-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-white);
  border: 2rpx solid var(--border-color);
}

.week-day__date-wrap--today {
  border-color: var(--primary-color);
  background: rgba(255, 107, 53, 0.06);
}

.week-day__date {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.week-day__dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #e0e0e0;
}

.week-day__dot--checked {
  background: var(--success-color);
  box-shadow: 0 0 8rpx rgba(107, 203, 119, 0.4);
}

.week-day__dot--pending {
  background: var(--warning-color);
}

.week-summary {
  text-align: center;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
  margin-top: 10rpx;
}

.week-summary__text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.highlight {
  color: var(--primary-color);
  font-weight: bold;
  font-size: 30rpx;
}

/* 连续签到奖励 */
.bonus-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #fff7e6, #fff3cc);
  border: 1rpx solid #ffe7ba;
}

.bonus-card__icon {
  font-size: 48rpx;
}

.bonus-card__info {
  flex: 1;
}

.bonus-card__title {
  font-size: 28rpx;
  font-weight: bold;
  color: #d46b08;
  display: block;
  margin-bottom: 4rpx;
}

.bonus-card__desc {
  font-size: 24rpx;
  color: #ad6800;
}

/* 规则列表 */
.rule-list { padding: 0 8rpx; }

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 0;
}

.rule-item__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary-color);
  margin-top: 14rpx;
  flex-shrink: 0;
}

.rule-item__text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.safe-bottom { height: 60rpx; }
