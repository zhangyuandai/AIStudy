/* ===== 首页样式 ===== */
.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 120rpx;
}

/* 头部区域 */
.header-section {
  background: linear-gradient(180deg, #1a1a2e 0%, #1a1a2e 40%, var(--bg-color) 100%);
  padding-bottom: 20rpx;
}

/* 用户栏 */
.user-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx 16rpx;
  gap: 20rpx;
}

.user-bar__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 217, 61, 0.5);
}

.user-bar__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-bar__name {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.user-bar__greeting {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.user-bar__notice {
  padding: 8rpx;
}

/* Section 通用 */
.section {
  margin: 20rpx 24rpx;
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.section__more {
  font-size: 26rpx;
  color: var(--primary-color);
}

/* 任务列表 */
.task-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.task-item:last-child {
  border-bottom: none;
}

.task-item__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 107, 53, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.task-item__icon--done {
  opacity: 0.5;
}

.task-item__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.task-item__title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.task-item__title--done {
  text-decoration: line-through;
  color: var(--text-muted);
}

.task-item__desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.task-item__reward {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 217, 61, 0.12);
  color: #d4a000;
  font-size: 22rpx;
}

.task-item__done-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(107, 203, 119, 0.1);
  color: var(--success-color);
  font-size: 22rpx;
}

/* 快捷入口 */
.quick-entry {
  display: flex;
  justify-content: space-around;
  padding: 28rpx 8rpx;
}

.quick-entry__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.quick-entry__icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-entry__emoji {
  font-size: 44rpx;
}

.quick-entry__label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 排行榜 */
.rank-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  position: relative;
}

.rank-item:not(:last-child) {
  border-bottom: 1rpx solid var(--border-color);
}

.rank-item__pos {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #f0f0f0;
  color: var(--text-muted);
}

.rank-item__pos--gold { background: linear-gradient(135deg, #ffd93d, #ffaa00); color: #fff; }
.rank-item__pos--silver { background: linear-gradient(135deg, #c0c0c0, #e8e8e8); color: #666; }
.rank-item__pos--bronze { background: linear-gradient(135deg, #cd7f32, #daa06d); color: #fff; }

.rank-item__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rank-item__name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-item__points {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: bold;
  margin-right: 8rpx;
}

.rank-item__me {
  background: var(--primary-color);
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

/* 热门礼品横向滚动 */
.hot-gifts-scroll {
  white-space: nowrap;
  margin: 0 -24rpx;
  padding: 0 24rpx;
}

.hot-gifts-list {
  display: inline-flex;
  gap: 20rpx;
}

.hot-gift-card {
  width: 240rpx;
  display: inline-flex;
  flex-direction: column;
  background: var(--bg-white);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  vertical-align: top;
}

.hot-gift-card__img {
  width: 240rpx;
  height: 200rpx;
  background: #f5f5f5;
}

.hot-gift-card__name {
  font-size: 24rpx;
  color: var(--text-primary);
  padding: 12rpx 14rpx 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}

.hot-gift-card__price {
  padding: 4rpx 14rpx 14rpx;
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.hot-gift-card__pts {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.hot-gift-card__price text:last-child {
  font-size: 20rpx;
  color: var(--primary-color);
}

.safe-bottom {
  height: 60rpx;
}
