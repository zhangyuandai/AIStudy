/* 个人中心样式 */
.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 60rpx;
}

/* 头部区域 */
.profile-header {
  position: relative;
  background: linear-gradient(180deg, #1a1a2e 0%, #2d2d5e 40%, var(--bg-color) 100%);
  padding-bottom: 20rpx;
}

.profile-header__bg {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,107,53,0.08), transparent);
  pointer-events: none;
}

.profile-header__content { position: relative; z-index: 1; }

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx 24rpx;
  gap: 20rpx;
}

.user-info__avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 217, 61, 0.4);
}

.user-info__detail { flex: 1; }

.user-info__name {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.user-info__level-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-info__id {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* 统计栏 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx 16rpx;
  margin: 20rpx 24rpx;
}

.stats-bar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.stats-bar__value {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.stats-bar__label {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 菜单卡片 */
.menu-card { padding: 0 8rpx; }

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child { border-bottom: none; }

.menu-item:active { background: #fafafa; }

.menu-item__left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.menu-item__icon { font-size: 36rpx; }

.menu-item__label { font-size: 30rpx; color: var(--text-primary); }

.menu-item__right { display: flex; align-items: center; gap: 8rpx; }

.menu-item__badge {
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}

.menu-item__arrow { width: 28rpx; height: 28rpx; opacity: 0.35; }

/* 店员入口 */
.staff-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f0f7ff, #e6f0ff);
  border: 1rpx solid #d0e3ff;
}

.staff-entry__icon { font-size: 48rpx; }

.staff-entry__info { flex: 1; }

.staff-entry__title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1677ff;
  display: block;
  margin-bottom: 4rpx;
}

.staff-entry__desc {
  font-size: 24rpx;
  color: #6699cc;
}

/* 页脚 */
.footer-info {
  text-align: center;
  padding: 40rpx 0 20rpx;
}
.footer-info text {
  font-size: 22rpx;
  color: var(--text-muted);
}

.safe-bottom { height: 60rpx; }
