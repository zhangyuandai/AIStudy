/* 积分卡片组件样式 */
.points-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2d5e 50%, #1a1a2e 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin: 20rpx 24rpx;
  color: #ffffff;
}

.points-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.points-card__label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.points-card__level {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 217, 61, 0.15);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.points-card__level-icon {
  width: 28rpx;
  height: 28rpx;
}

.points-card__level-text {
  font-size: 22rpx;
  color: #ffd93d;
}

.points-card__main {
  margin-bottom: 24rpx;
}

.points-card__balance-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.points-card__balance {
  font-size: 72rpx;
  font-weight: bold;
  line-height: 1.2;
  background: linear-gradient(135deg, #ffd93d, #ff9f43);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.points-card__unit {
  font-size: 28rpx;
  color: rgba(255, 217, 61, 0.8);
}

.points-card__frozen {
  margin-top: 8rpx;
}

.points-card__frozen-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* 等级进度条 */
.points-card__progress {
  margin-bottom: 20rpx;
}

.points-card__progress-bar {
  height: 10rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.points-card__progress-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #ffd93d, #ff9f43);
  transition: width 0.3s ease;
}

.points-card__progress-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.points-card__progress-highlight {
  color: #ffd93d;
  font-weight: bold;
}

/* 统计信息 */
.points-card__stats {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.points-card__stat-item {
  flex: 1;
  text-align: center;
}

.points-card__stat-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffd93d;
  display: block;
}

.points-card__stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  display: block;
  margin-top: 4rpx;
}

.points-card__stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.15);
}

/* 装饰圆 */
.points-card__deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.points-card__deco--circle1 {
  width: 200rpx;
  height: 200rpx;
  top: -80rpx;
  right: -40rpx;
  background: radial-gradient(circle, rgba(255, 107, 53, 0.15), transparent);
}

.points-card__deco--circle2 {
  width: 150rpx;
  height: 150rpx;
  bottom: -60rpx;
  left: -30rpx;
  background: radial-gradient(circle, rgba(255, 217, 61, 0.1), transparent);
}
